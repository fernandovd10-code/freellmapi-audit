# Copia este archivo a:
#   Linux / macOS / WSL: ~/.config/freellmapi.env  (y ejecuta: chmod 600 ~/.config/freellmapi.env)
#   Windows:             %USERPROFILE%\.config\freellmapi.env
#
# También puedes configurarlo de forma interactiva con:
#   python freellm_audit.py --init

# URL base de tu instancia FreeLLMAPI (con o sin /v1 al final)
FREELLM_BASE=http://localhost:3001

# Alternativamente puedes indicar host y puerto por separado si no defines FREELLM_BASE:
# FREELLM_HOST=localhost
# FREELLM_PORT=3001

# Tu API key unificada de FreeLLMAPI
FREELLM_KEY=freellmapi-reemplaza-con-tu-clave

# Opcional: sobreescribe la ruta del histórico local de ESTE equipo (no usar carpetas sincronizadas)
# FREELLM_DATA_DIR=
